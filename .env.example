# Copy this file to .env and fill in real values. .env is gitignored.

# Path to the Google OAuth "installed app" client secret JSON downloaded from
# Google Cloud Console (APIs & Services > Credentials). Required only for
# `statement-tool fetch-email`.
GMAIL_CLIENT_SECRET_FILE=credentials.json

# Where the OAuth token cache is stored after the first successful login.
# It is created automatically on first run - do not commit it.
GMAIL_TOKEN_FILE=token.json

# Optional: override default file locations.
# CLIENTS_CONFIG=config/clients.yaml
# BANKS_CONFIG=config/banks.yaml
# PROCESSED_DB=data/processed/processed.db
# OUTPUT_WORKBOOK=output/combined_statements.xlsx

# Optional: only needed if Tesseract/Poppler are not on PATH (Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
